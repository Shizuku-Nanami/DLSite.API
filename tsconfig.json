{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["WebWorker", "ES2020", "DOM"],
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"]
} 